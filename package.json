{
  "name": "session-bridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run --maxWorkers=1",
    "lint": "biome check .",
    "format": "biome check --write .",
    "dev:web": "pnpm --filter @bridge/web dev",
    "dev:desktop": "pnpm --filter @bridge/desktop dev",
    "start": "pnpm build && pnpm --filter @bridge/desktop start",
    "m0": "node scripts/m0.mjs",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^24.10.0",
    "electron": "^44.10.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "esbuild": "^0.27.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
