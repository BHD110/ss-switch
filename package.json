{
  "name": "session-bridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter @bridge/desktop build && pnpm --filter @bridge/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run --maxWorkers=1",
    "lint": "biome check .",
    "format": "biome check --write .",
    "dev:web": "pnpm --filter @bridge/web dev",
    "dev:desktop": "pnpm --filter @bridge/desktop dev",
    "start": "pnpm build && pnpm --filter @bridge/desktop start",
    "m0": "node scripts/build-node.mjs scripts/m0.ts .tmp/m0.cjs && node .tmp/m0.cjs",
    "doctor": "node scripts/build-node.mjs scripts/doctor.ts .tmp/doctor.cjs && node .tmp/doctor.cjs",
    "probe": "node scripts/build-node.mjs scripts/verify-live.ts .tmp/verify-live.cjs && node .tmp/verify-live.cjs",
    "package:win": "pnpm --filter @bridge/desktop package",
    "test:e2e": "node scripts/build-node.mjs scripts/e2e.ts .tmp/e2e.cjs && node .tmp/e2e.cjs",
    "package:portable": "pnpm build && cd apps/bridge-desktop && pnpm exec electron-builder --win portable",
    "package:installer": "pnpm package:win && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-installer.ps1",
    "repair:zcode": "node scripts/build-node.mjs scripts/repair-zcode.ts .tmp/repair-zcode.cjs && node .tmp/repair-zcode.cjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^24.10.0",
    "electron": "^44.10.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.27.7",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "electron-winstaller"
    ]
  }
}
